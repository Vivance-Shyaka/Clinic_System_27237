      "name": "aggregates and bulk updates",
      "item": [
        {
          "name": "C1. Appointments per Status",
          "item": [
            {
              "name": "C1 · GET /api/appointment/stats/by-status",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                      "const rows = pm.response.json();",
                      "const valid = [\"SCHEDULED\", \"CONFIRMED\", \"COMPLETED\", \"CANCELLED\"];",
                      "const total = rows.reduce((s, r) => s + r[1], 0);",
                      "pm.collectionVariables.set(\"statsTotal\", String(total));",
                      "pm.test(\"Every row is [status, count]\", function () { pm.expect(rows.length > 0 && rows.every(r => Array.isArray(r) && r.length === 2 && valid.includes(r[0]) && typeof r[1] === \"number\")).to.be.true; });",
                      "pm.test(\"All four statuses have at least one appointment\", function () { pm.expect(valid.every(s => rows.some(r => r[0] === s && r[1] >= 1))).to.be.true; });",
                      "pm.test(\"One row per status (no repeats)\", function () { pm.expect(new Set(rows.map(r => r[0])).size === rows.length).to.be.true; });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
