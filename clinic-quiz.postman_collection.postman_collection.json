          "name": "A1. Find Patients by Last Name",
          "item": [
            {
              "name": "A1 · GET /api/patient/by-last-name?lastName=uwase",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                      "const names = arr => arr.map(x => x.firstName + \" \" + x.lastName);",
                      "const list = pm.response.json();",
                      "pm.collectionVariables.set(\"a1Count\", String(list.length));",
                      "pm.test(\"Every patient has the last name Uwase (any letter case)\", function () { pm.expect(list.length > 0 && list.every(p => p.lastName.toLowerCase() === \"uwase\")).to.be.true; });",
                      "pm.test(\"Claudine and Jean are in the list\", function () { pm.expect(names(list).includes(\"Claudine Uwase\") && names(list).includes(\"Jean Uwase\")).to.be.true; });",
                      "pm.test(\"Sorted by first name, A to Z\", function () { const f = list.map(p => p.firstName); pm.expect(f.join() === f.slice().sort((a, b) => a.localeCompare(b)).join()).to.be.true; });",
                      "pm.test(\"Eric Habimana is NOT in the list\", function () { pm.expect(!names(list).includes(\"Eric Habimana\")).to.be.true; });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/patient/by-last-name?lastName=uwase",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "patient",
