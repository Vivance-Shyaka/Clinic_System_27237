          "name": "A3. Appointments in a Date Range",
          "item": [
            {
              "name": "A3 · GET /api/appointment/between?start=2026-10-01&end=2026-10-31",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                      "const d = a => String(a.appointmentDate).substring(0, 10);",
                      "const isSorted = arr => arr.join() === arr.slice().sort().join();",
                      "const list = pm.response.json();",
                      "const reasons = list.map(a => a.reason);",
                      "pm.test(\"Every date is inside 2026-10-01 .. 2026-10-31\", function () { pm.expect(list.length > 0 && list.every(a => d(a) >= \"2026-10-01\" && d(a) <= \"2026-10-31\")).to.be.true; });",
                      "pm.test(\"Both ends are included (Follow-up on 10-01, Annual review on 10-31)\", function () { pm.expect(reasons.includes(\"Follow-up\") && reasons.includes(\"Annual review\")).to.be.true; });",
                      "pm.test(\"Outside the range: Out of range (11-05) and Cancelled visit (09-15) are NOT included\", function () { pm.expect(!reasons.includes(\"Out of range\") && !reasons.includes(\"Cancelled visit\")).to.be.true; });",
                      "pm.test(\"Sorted by date, earliest first\", function () { pm.expect(isSorted(list.map(d))).to.be.true; });"
